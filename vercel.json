{
    "rewrites": [
        { "source": "/api/:path*", "destination": "https://api-orbitplay.onrender.com/api/:path*" }
    ],
    "headers": [
        {
            "source": "/",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        }
    ]
}
    